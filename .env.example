# Copy to .env for local development. Never commit .env files.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://ruralattend_user:replace_me@127.0.0.1:5432/ruralattend
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PG_POOL_SIZE=10
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
PASSWORD_RESET_MINUTES=30

# Only used by the explicit local seed command. Set a unique value before running it.
SEED_PASSWORD=
SEED_TEACHER_EMAIL=teacher@ruralattend.demo
SEED_PRINCIPAL_EMAIL=principal@ruralattend.demo
SEED_ADMIN_EMAIL=admin@ruralattend.demo
SEED_PARENT_EMAIL=parent@ruralattend.demo
SEED_DEPARTMENT_EMAIL=department@ruralattend.demo

# Frontend: set VITE_DEMO_MODE=true only when intentionally using the local evaluation demo.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=/api
